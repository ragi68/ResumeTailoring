{
  "name": "resume-tailor-ext",
  "private": true,
  "version": "0.1.0",
  "description": "Tailor your master resume to a job description and attach it to the application upload.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "testpage": "node scripts/serve-test-page.mjs",
    "e2e": "node scripts/e2e-attach.mjs",
    "postinstall": "wxt prepare",
    "build:e2e": "wxt build --mode e2e",
    "e2e:ui": "node scripts/e2e-ui.mjs",
    "smoke": "node scripts/smoke-load.mjs",
    "e2e:tailor": "node scripts/e2e-tailor.mjs",
    "e2e:errors": "node scripts/e2e-errors.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "pdfjs-dist": "^5.7.284",
    "pdfmake": "^0.3.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
